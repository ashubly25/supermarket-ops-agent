# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Model access — set ONE of these. A direct Anthropic key wins if both are present.
ANTHROPIC_API_KEY=          # sk-ant-... — talk to Anthropic directly
AI_GATEWAY_API_KEY=         # vck_...    — route via the Vercel AI Gateway

# Optional overrides
DB_PATH=./data/store.db
ARTIFACTS_DIR=./artifacts
MODEL=anthropic/claude-sonnet-5
