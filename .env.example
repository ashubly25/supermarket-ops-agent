# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Model access — set ONE of these. Checked in this order; the first one set wins.
ANTHROPIC_API_KEY=          # sk-ant-... — talk to Anthropic directly
OPENROUTER_API_KEY=         # sk-or-...  — route via OpenRouter
AI_GATEWAY_API_KEY=         # vck_...    — route via the Vercel AI Gateway
#   An sk-or- key left in AI_GATEWAY_API_KEY is detected and routed to OpenRouter
#   anyway: handing it to Vercel's gateway 401s with a message that reads as if the
#   variable were unset, which is a genuinely hard hour to get back.

# Optional overrides
DB_PATH=./data/store.db
ARTIFACTS_DIR=./artifacts
MODEL=anthropic/claude-sonnet-5
